# Canonical OSS origin (sitemap, Open Graph, shadcn /r/*). Production fallback
# is https://aicronus.com. Unset in `next dev` is fine — metadata still works.
# NEXT_PUBLIC_SITE_URL=https://aicronus.com

# Public origin of Cronus Pro (See Pro / Explore Pro leave this site).
# `next dev` falls back to http://localhost:4748; production is https://iacronus.com.
NEXT_PUBLIC_PRO_URL=http://localhost:4748

# Optional coffee checkout. Defaults to GitHub Sponsors for pedrogbraz
# (custom one-time amounts). Point at Buy Me a Coffee / Ko-fi if you prefer:
# NEXT_PUBLIC_SPONSOR_URL=https://buymeacoffee.com/yourname
# NEXT_PUBLIC_SPONSOR_URL=
