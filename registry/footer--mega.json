      "path": "footer-mega.tsx",
      "content": "\"use client\";\n\nimport { Button, Input, Label, Separator } from \"@cronus-ui/ui\";\nimport { Hexagon, Send } from \"lucide-react\";\nimport type { SVGProps } from \"react\";\n\nfunction GithubGlyph(props: SVGProps<SVGSVGElement>) {\n  return (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width=\"24\"\n      height=\"24\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      strokeWidth=\"2\"\n      strokeLinecap=\"round\"\n      strokeLinejoin=\"round\"\n      aria-hidden=\"true\"\n      {...props}\n    >\n      <path d=\"M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4\" />\n      <path d=\"M9 18c-4.51 2-5-2-7-2\" />\n    </svg>\n  );\n}\n\nfunction LinkedinGlyph(props: SVGProps<SVGSVGElement>) {\n  return (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width=\"24\"\n      height=\"24\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      strokeWidth=\"2\"\n      strokeLinecap=\"round\"\n      strokeLinejoin=\"round\"\n      aria-hidden=\"true\"\n      {...props}\n    >\n      <path d=\"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z\" />\n      <rect width=\"4\" height=\"12\" x=\"2\" y=\"9\" />\n      <circle cx=\"4\" cy=\"4\" r=\"2\" />\n    </svg>\n  );\n}\n\nfunction TwitterGlyph(props: SVGProps<SVGSVGElement>) {\n  return (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width=\"24\"\n      height=\"24\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      strokeWidth=\"2\"\n      strokeLinecap=\"round\"\n      strokeLinejoin=\"round\"\n      aria-hidden=\"true\"\n      {...props}\n    >\n      <path d=\"M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z\" />\n    </svg>\n  );\n}\n\nconst FOOTER_MEGA_COLUMNS = [\n  {\n    heading: \"Product\",\n    links: [\n      { label: \"Features\", href: \"#features\" },\n      { label: \"Pricing\", href: \"#pricing\" },\n      { label: \"Blocks\", href: \"#blocks\" },\n      { label: \"Themes\", href: \"#themes\" },\n      { label: \"Changelog\", href: \"#changelog\" },\n    ],\n  },\n  {\n    heading: \"Developers\",\n    links: [\n      { label: \"Documentation\", href: \"#docs\" },\n      { label: \"API reference\", href: \"#api\" },\n      { label: \"CLI\", href: \"#cli\" },\n      { label: \"Open source\", href: \"#open-source\" },\n    ],\n  },\n  {\n    heading: \"Company\",\n    links: [\n      { label: \"About\", href: \"#about\" },\n      { label: \"Careers\", href: \"#careers\" },\n      { label: \"Customers\", href: \"#customers\" },\n      { label: \"Press kit\", href: \"#press\" },\n    ],\n  },\n  {\n    heading: \"Resources\",\n    links: [\n      { label: \"Guides\", href: \"#guides\" },\n      { label: \"Templates\", href: \"#templates\" },\n      { label: \"Community\", href: \"#community\" },\n      { label: \"Support\", href: \"#support\" },\n    ],\n  },\n  {\n    heading: \"Legal\",\n    links: [\n      { label: \"Privacy\", href: \"#privacy\" },\n      { label: \"Terms\", href: \"#terms\" },\n      { label: \"Security\", href: \"#security\" },\n      { label: \"DPA\", href: \"#dpa\" },\n    ],\n  },\n];\n\nexport function FooterMegaBlock() {\n  return (\n    <footer className=\"border-t border-border bg-surface-base px-6 py-16\">\n      <div className=\"mx-auto max-w-6xl\">\n        <div className=\"flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between\">\n          <div className=\"max-w-sm\">\n            <div className=\"flex items-center gap-2.5\">\n              <span className=\"grid size-9 place-items-center rounded-xl bg-gradient-primary text-primary-foreground shadow-glow\">\n                <Hexagon aria-hidden=\"true\" className=\"size-5\" />\n              </span>\n              <span className=\"font-display text-lg font-semibold text-fg\">Cronus</span>\n            </div>\n            <p className=\"mt-4 text-sm leading-6 text-fg-secondary\">\n              Product updates, new blocks, and launch guides — a few times a month.\n            </p>\n          </div>\n          <form\n            className=\"flex w-full max-w-md flex-col gap-3 sm:flex-row\"\n            onSubmit={(event) => event.preventDefault()}\n          >\n            <div className=\"flex-1\">\n              <Label htmlFor=\"footer-mega-email\" className=\"sr-only\">\n                Email address\n              </Label>\n              <Input\n                id=\"footer-mega-email\"\n                type=\"email\"\n                required\n                placeholder=\"you@company.com\"\n                autoComplete=\"email\"\n              />\n            </div>\n            <Button type=\"submit\" variant=\"primary\">\n              Subscribe\n              <Send aria-hidden=\"true\" />\n            </Button>\n          </form>\n        </div>\n\n        <div className=\"mt-14 grid gap-10 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5\">\n          {FOOTER_MEGA_COLUMNS.map((column) => (\n            <div key={column.heading}>\n              <h3 className=\"text-sm font-medium text-fg\">{column.heading}</h3>\n              <ul className=\"mt-4 flex flex-col gap-3\">\n                {column.links.map((link) => (\n                  <li key={link.label}>\n                    <a\n                      href={link.href}\n                      className=\"text-sm text-fg-secondary transition-colors hover:text-fg\"\n                    >\n                      {link.label}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n\n        <Separator className=\"my-10\" />\n\n        <div className=\"flex flex-col-reverse items-center justify-between gap-6 lg:flex-row\">\n          <p className=\"text-sm text-fg-tertiary\">© 2026 Cronus Labs, Inc. All rights reserved.</p>\n          <div className=\"flex flex-col items-center gap-4 sm:flex-row sm:gap-6\">\n            <a\n              href=\"#status\"\n              className=\"inline-flex items-center gap-2 text-sm font-medium text-success-strong transition-colors hover:text-fg\"\n            >\n              <span aria-hidden=\"true\" className=\"size-2 rounded-full bg-success\" />\n              All systems operational\n            </a>\n            <div className=\"flex items-center gap-1\">\n              <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"GitHub\">\n                <GithubGlyph aria-hidden=\"true\" />\n              </Button>\n              <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"Twitter\">\n                <TwitterGlyph aria-hidden=\"true\" />\n              </Button>\n              <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"LinkedIn\">\n                <LinkedinGlyph aria-hidden=\"true\" />\n              </Button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n}",
