{
  "name": "create-kronus-app",
  "version": "0.5.0",
  "description": "Scaffold a Next.js + Kronus UI app: npx create-kronus-app my-app --template saas.",
  "type": "module",
  "license": "MIT",
  "author": "Kronus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrogbraz/kronus-ui.git",
    "directory": "packages/create-kronus-app"
  },
  "homepage": "https://github.com/pedrogbraz/kronus-ui#readme",
  "bugs": {
    "url": "https://github.com/pedrogbraz/kronus-ui/issues"
  },
  "keywords": [
    "kronus",
    "create-kronus-app",
    "design-system",
    "next",
    "scaffold",
    "starter",
    "tailwind",
    "ui"
  ],
  "bin": {
    "create-kronus-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "README.md",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kronus-ui/ai-kit": "workspace:*",
    "kronus-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
