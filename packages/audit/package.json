    "cli": "bun src/cli.ts",
    "inventory": "bun src/catalog-inventory.ts",
    "emit": "bun src/cli.ts emit",
    "audit:dev": "bun src/audit-dev.ts"
  },
  "dependencies": {
    "@cronus-ui/tokens": "workspace:*",
    "@cronus-ui/ui": "workspace:*",
