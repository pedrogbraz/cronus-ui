{
  "name": "@cronus-ui/audit",
  "version": "0.0.0",
  "private": true,
  "description": "Cronus Audit harness — language/logic/visual parity against @cronus-ui/ui.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
