{
  "name": "admin",
  "type": "registry:app",
  "planVersion": 1,
  "manifest": {
    "title": "Admin",
    "description": "An admin console: split login, an (app) shell, overview, users, analytics, a sprint board and an audit trail — composed from validated blocks.",
    "chrome": {
      "shell": { "block": "app-shell-chrome" },
      "bare": {}
    },
    "pages": [
      {
        "route": "/login",
        "title": "Sign in",
        "chrome": "bare",
        "blocks": [{ "block": "login", "variant": "split" }]
      },
      {
        "route": "/forgot-password",
        "title": "Reset password",
        "chrome": "bare",
        "blocks": ["forgot-password"]
      },
      {
        "route": "/reset-password",
        "title": "Set new password",
        "chrome": "bare",
        "blocks": [{ "block": "forgot-password", "variant": "reset" }]
      },
      {
        "route": "/",
        "title": "Overview",
        "nav": "Overview",
        "chrome": "shell",
        "blocks": [{ "block": "dashboard", "variant": "admin-overview" }]
      },
      {
        "route": "/users",
        "title": "Users",
        "nav": "Users",
        "chrome": "shell",
        "blocks": ["user-management"]
      },
      {
        "route": "/analytics",
        "title": "Analytics",
        "nav": "Analytics",
        "chrome": "shell",
        "blocks": [{ "block": "analytics", "variant": "engagement" }]
      },
      {
        "route": "/board",
        "title": "Board",
        "nav": "Board",
        "chrome": "shell",
        "blocks": ["kanban-board"]
      },
      {
        "route": "/audit",
        "title": "Audit log",
        "nav": "Audit",
        "chrome": "shell",
        "blocks": ["audit-log"]
      }
    ],
    "extras": { "not-found": "not-found" },
    "defaults": { "theme": "midnight", "mode": "dark", "brand": "__APP_NAME__" }
  }
}
